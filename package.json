{
  "name": "@scandinavianairlines/react-router-azure-functions",
  "version": "3.1.0",
  "description": "A package that adapts requests between Azure Functions and React Router",
  "keywords": [
    "adapter",
    "azure",
    "functions",
    "react-router",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scandinavianairlines/react-router-azure-functions.git"
  },
  "license": "MIT",
  "author": "Airline Digitalization <airlinedigitalization@flysas.com>",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "CHANGELOG.md",
    "index.d.ts",
    "index.js",
    "README.md",
    "src/server.js",
    "types/**/*.d.ts"
  ],
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write index.js \"src/**/*.js\"",
    "lint": "TIMING=1 eslint --fix *.js src/",
    "postinstall": "husky",
    "postpack": "pinst --enable",
    "prepack": "pinst --disable",
    "prepublishOnly": "tsc --emitDeclarationOnly",
    "test": "vitest --coverage",
    "types": "tsc --noEmit --checkJs"
  },
  "peerDependencies": {
    "react": "^18.x || ^19.x",
    "react-router": "^7.x || ^8.x"
  },
  "devDependencies": {
    "@azure/functions": "^4.16.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "commitizen": "^4.3.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-disable": "^2.0.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^65.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "lint-staged": "^17.6.0",
    "pinst": "^3.0.0",
    "prettier": "^3.9.9",
    "ramda": "^0.32.0",
    "react": "^19.3.0",
    "react-router": "^8.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "yarn@4.17.0"
}
